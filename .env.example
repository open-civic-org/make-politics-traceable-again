# Copy to .env for local development. Never commit secrets.

# PostgreSQL (PostGIS)
POSTGRES_USER=mpta
POSTGRES_PASSWORD=mpta_dev_password
POSTGRES_DB=mpta
DATABASE_URL=postgresql+psycopg://mpta:mpta_dev_password@localhost:5432/mpta

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible local object storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mpta-raw
S3_REGION=us-east-1

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser calls go to ${NEXT_PUBLIC_API_URL}/api/v1/...
WEB_PORT=3000
ADMIN_PORT=3001
